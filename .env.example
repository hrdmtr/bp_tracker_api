# Application Settings
APP_ENV=development
APP_NAME=bp-tracker-api
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# CORS (カンマ区切りで複数指定可能)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenAI API (Secret Manager推奨)
# 本番環境ではSecret Managerから取得
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=30

# OpenWeatherMap API (Secret Manager推奨)
# 本番環境ではSecret Managerから取得
OPENWEATHERMAP_API_KEY=your-openweathermap-api-key-here
OPENWEATHERMAP_TIMEOUT=10

# Supabase (Secret Manager推奨)
# 本番環境ではSecret Managerから取得
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Rate Limiting
RATE_LIMIT_RECOGNITION_DAILY=100
RATE_LIMIT_WEATHER_DAILY=500
RATE_LIMIT_IP_HOURLY=1000

# Image Upload
MAX_IMAGE_SIZE_MB=10
